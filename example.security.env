# Configuración de desarrollo del despliegue de seguridad.
# Usar: docker compose --env-file example.security.env ...
# Proyecto distinto del experimento de disponibilidad: no comparte volúmenes.
STACK=solventa-security
TAG=dev
REDIS_TAG=8.10-alpine
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Gestión Cotizador
STREAM_COTIZADOR=sol:cotizador
PREFIJO_RESPUESTAS=resp
TTL_RESPUESTAS_S=60
TARIFARIO_VERSION=2026.02
