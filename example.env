# Contrato de configuración del monorepo Solventa — experimento de seguridad.
# Copiar a .env y ajustar. El .env NUNCA se commitea.

# --- Identidad del stack -----------------------------------------------------
STACK=solventa
TAG=dev

# --- Cola --------------------------------------------------------------------
# Tag flotante: cómodo en desarrollo. Para la corrida oficial fijar
# 8.10.1-alpine3.23 o el digest, de modo que el resultado no cambie si Docker
# Hub mueve el tag.
REDIS_TAG=8.10-alpine
REDIS_URL=redis://redis:6379/0
# Solicitudes hacia el plano de negocio (un consumer group por stream).
STREAM_POLIZAS=sol:polizas
STREAM_COTIZADOR=sol:cotizador
# Respuestas de los workers: lista resp:{correlation_id}.
PREFIJO_RESPUESTAS=resp
# Eventos de auditoría (gestion-polizas -> auditor) y de seguridad
# (validacion -> su proceso interno de Reacción).
STREAM_AUDITORIA=auditoria
STREAM_SEGURIDAD=seguridad
# Tope de cada stream: sin él la memoria de Redis crece sin límite bajo carga.
STREAM_MAXLEN=10000
# Cuánto espera Validación la respuesta de un worker antes de responder 504.
TIMEOUT_RESPUESTA_MS=2000
# Vida de la lista de respuestas si Validación ya se rindió.
TTL_RESPUESTAS_S=60

# --- Autenticación -----------------------------------------------------------
# Solo Autenticación conoce el secreto: para el resto el token es opaco.
JWT_SECRET=cambiar-este-secreto-de-desarrollo
# Vida del token. Larga a propósito: la expiración no debe interferir con las
# mediciones del experimento.
JWT_TTL_S=3600

# --- Experimento -------------------------------------------------------------
# Habilita los endpoints que simulan al atacante (alterar rol) y al canal OTP
# legítimo (leer el código). Solo en desarrollo y durante el experimento.
MODO_EXPERIMENTO=true
# Periodo del ciclo del Auditor. Gobierna la ventana de exposición de ASR-31.
PERIODO_AUDITORIA_S=5

# --- Direcciones internas (red backend, nombre DNS del servicio) -------------
URL_AUTENTICACION=http://autenticacion:8000
URL_VALIDACION=http://validacion:8000
# Máximo de espera del gateway por una llamada interna.
UPSTREAM_TIMEOUT_MS=3000

# --- Cotizador ---------------------------------------------------------------
TARIFARIO_VERSION=2026.02

# --- Puertos publicados (solo desarrollo) ------------------------------------
PUERTO_GATEWAY=8000
PUERTO_AUTENTICACION=8001
PUERTO_VALIDACION=8002
# Tablero de Locust durante el experimento (http://127.0.0.1:8089).
PUERTO_LOCUST=8089
# Reporte en vivo de la corrida (http://127.0.0.1:8090), abierto por correr.sh.
PUERTO_TABLERO=8090

# --- Observabilidad ----------------------------------------------------------
LOG_LEVEL=INFO
