# Contrato de configuración del monorepo Solventa.
# Copiar a .env y ajustar. El .env NUNCA se commitea.

# --- Identidad del stack -----------------------------------------------------
STACK=solventa
TAG=dev

# --- Cola --------------------------------------------------------------------
# Tag flotante: cómodo en desarrollo. Para una corrida de experimento
# reproducible conviene fijar 8.10.1-alpine3.23 o el digest, de modo que el
# resultado no cambie si Docker Hub mueve el tag.
REDIS_TAG=8.10-alpine
REDIS_URL=redis://redis:6379/0
STREAM_SOLICITUDES=cot:req
PREFIJO_RESPUESTAS=cot:resp

# --- Votación (ASR-11 / ASR-12) ----------------------------------------------
# Réplicas que se espera que respondan.
REPLICAS_ESPERADAS=3
# Respuestas coincidentes necesarias para dar consenso.
QUORUM=2
# Presupuesto GLOBAL de recolección, no timeout por respuesta.
# 250 ms deja 50 ms de margen sobre los 300 ms que exige ASR-12.
TIMEOUT_CONSENSO_MS=250
# Ventana extra, tras alcanzar quórum, para recoger a las rezagadas. El
# veredicto ya está decidido: esta espera NO cambia lo que se responde, solo
# permite ver a la réplica divergente y registrarla. Sin ella ASR-12 se
# cumpliría y ASR-11 fallaría de forma intermitente.
GRACIA_TRAS_QUORUM_MS=25
# Tope del stream: sin él la memoria de Redis crece sin límite bajo carga.
STREAM_MAXLEN=10000
# Expone el bloque "consenso" en la respuesta. ASR-12 exige responder sin
# exponer el error: true solo en desarrollo y durante el experimento.
EXPOSE_CONSENSUS=true
# Destino de los incidentes (red `backend`, nombre DNS del servicio).
URL_GESTION_ERRORES=http://gestion-errores:8000

# --- Cotizador ---------------------------------------------------------------
TARIFARIO_VERSION=2026.02
# Fallo inyectado por réplica. Valores en PLAN-IMPLEMENTACION.md §2.6:
# none | premium_offset | factor_skip | rate_table_stale | rounding_drift
# | out_of_range | silent_zero | slow | crash
FAULT_A=none
FAULT_B=none
FAULT_C=none

# --- API Gateway -------------------------------------------------------------
URL_VOTACION=http://votacion:8000
# Presupuesto de la llamada a Votación: por encima de su consenso (250 ms) y
# dentro de los 300 ms que ASR-12 concede al journey completo.
TIMEOUT_VOTACION_MS=300
# Flag propio del gateway, distinto del de Votación: el borde no delega en el
# interior la decisión de qué puede ver el socio. ASR-12 exige responder sin
# exponer el error, así que el valor correcto es false: el socio no ve el
# bloque `consenso` ni durante el experimento. La evidencia se mide en
# gestion-errores y en el puerto directo de Votación, no en el borde.
EXPOSE_CONSENSUS_GATEWAY=false
# Peticiones por minuto y socio. Holgado para no falsear las mediciones de F7.
LIMITE_POR_MINUTO=6000

# --- Puertos publicados (solo desarrollo) ------------------------------------
PUERTO_GATEWAY=8000
PUERTO_VOTACION=8002
PUERTO_GESTION_ERRORES=8003

# --- Observabilidad ----------------------------------------------------------
LOG_LEVEL=INFO
